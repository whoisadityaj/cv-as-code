<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ data.name }} — CV</title>
<meta name="author" content="{{ data.name }}" />
{% if data.title %}<meta name="description" content="{{ data.title }}" />{% endif %}
<style>{{ css | safe }}</style>
{% if page_size %}<style>@page { size: {{ page_size }}; }</style>{% endif %}
</head>
{#- ------------------------------------------------------------ contact items -#}
{%- set c = data.contact or {} -%}
{%- set contacts = [] -%}
{%- if c.phone %}{% set _ = contacts.append({'kind': 'phone', 'text': c.phone}) %}{% endif -%}
{%- if c.email %}{% set _ = contacts.append({'kind': 'email', 'href': 'mailto:' ~ c.email, 'text': c.email}) %}{% endif -%}
{%- for key, label in [('website', 'portfolio'), ('linkedin', 'linkedin'), ('github', 'github')] -%}
  {%- set url = c[key] -%}
  {%- if url -%}
    {%- set href = url if url.startswith('http') else 'https://' ~ url -%}
    {%- set _ = contacts.append({'kind': key, 'href': href, 'text': (href | display_url) if (ats or stacked_contacts) else label}) -%}
  {%- endif -%}
{%- endfor -%}
{%- if c.location %}{% set _ = contacts.append({'kind': 'location', 'text': c.location}) %}{% endif -%}

{#- ------------------------------------------------------------ section macros -#}
{%- macro contact_item(it) -%}
  {%- if it.href %}<a class="c-{{ it.kind }}" href="{{ it.href }}">{{ it.text }}</a>{% else %}<span class="c-{{ it.kind }}">{{ it.text }}</span>{% endif -%}
{%- endmacro -%}

{%- macro contact_line() -%}
  <div class="contact">
    {%- for it in contacts -%}
      {%- if not loop.first %}{% if ats %} | {% else %}<span class="sep">●</span>{% endif %}{% endif -%}
      {{ contact_item(it) }}
    {%- endfor %}
  </div>
{%- endmacro -%}

{%- macro contact_list() -%}
  <ul class="contact-list">
    {%- for it in contacts %}<li>{{ contact_item(it) }}</li>{% endfor -%}
  </ul>
{%- endmacro -%}

{%- macro summary() -%}
  {% if data.summary %}<section class="cv-summary">{{ data.summary | md }}</section>{% endif %}
{%- endmacro -%}

{%- macro skills() -%}
  {% if data.skills %}
  <section class="section skills">
    <h2>Skills</h2>
    {% for group in data.skills %}
    <div class="group">
      <span class="label">{{ group.group }}:</span>
      <span class="items">
        {%- for item in group['items'] -%}
          <span class="skill">
          {%- if item.bold or item.level -%}
            <strong>{{ item.name | md }}</strong>
          {%- else -%}
            {{ item.name | md }}
          {%- endif -%}
          {%- if item.level %} <span class="level">({{ item.level }})</span>{% endif -%}
          </span>
          {%- if not loop.last %}<span class="comma">, </span>{% endif -%}
        {%- endfor -%}<span class="comma">.</span>
      </span>
    </div>
    {% endfor %}
  </section>
  {% endif %}
{%- endmacro -%}

{%- macro experience() -%}
  {% if data.experience %}
  <section class="section experience">
    <h2>Experience</h2>
    {% for job in data.experience %}
    <div class="entry">
      <div class="row1">
        <div class="role">{{ job.role | md }}</div>
        <div class="dates">{{ job.start }} – {{ job.end }}</div>
      </div>
      <div class="row2">
        <div class="company-line">
          <span class="company">{{ job.company | md }}</span>{% if job.location %}<span class="separator"> | </span><span class="location">{{ job.location | md }}</span>{% endif %}
        </div>
      </div>
      {% if job.intro %}<div class="intro">{{ job.intro | md }}</div>{% endif %}
      {% if job.bullets %}
      {% if (data.style or {}).get('show_accomplishments_label', true) %}
      <span class="accomplishments-label">{{ job.accomplishments_label or "Key Accomplishments:" }}</span>
      {% endif %}
      <ul>
        {% for b in job.bullets %}
        <li>{{ (b.text if b is mapping else b) | md }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}
{%- endmacro -%}

{%- macro education() -%}
  {% if data.education %}
  <section class="section education">
    <h2>Education</h2>
    {% for ed in data.education %}
    <div class="entry">
      <div class="row1">
        <div class="role"><strong>{{ ed.school }}</strong>{% if ed.degree %} <span class="degree-inline">| {{ ed.degree | md }}</span>{% endif %}{% if ed.extra %} <span class="extra-inline">| {{ ed.extra | md }}</span>{% endif %}</div>
        <div class="dates">{{ ed.start }} – {{ ed.end }}</div>
      </div>
      {% if ed.bullets %}
      {% if ed.bullets_label %}<span class="accomplishments-label">{{ ed.bullets_label }}</span>{% endif %}
      <ul>
        {% for b in ed.bullets %}
        <li>{{ b | md }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}
{%- endmacro -%}

{#- `startups:` and `projects:` share one layout: name | stack | links, then bullets -#}
{%- macro project_list(key, title) -%}
  {% if data[key] %}
  <section class="section projects {{ key }}">
    <h2>{{ title }}</h2>
    {% for p in data[key] %}
    <div class="entry">
      <div class="row1">
        <div class="role">
          <strong>{{ p.name }}</strong>
          {% if p.stack %}<span class="stack"> | {{ p.stack }}</span>{% endif %}
          {% if p.links %}{% for l in p.links %} <span class="links"> | {{ l.label }} <a href="{{ l.url }}">{{ l.url | replace('https://', '') | replace('http://', '') }}</a></span>{% endfor %}{% endif %}
        </div>
      </div>
      {% if p.bullets %}
      <ul>
        {% for b in p.bullets %}<li>{{ b | md }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}
{%- endmacro -%}

{%- macro simple_list(key, title) -%}
  {% if data[key] %}
  <section class="section {{ key }}">
    <h2>{{ title }}</h2>
    <ul>
      {% for item in data[key] %}<li>{{ item | md }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}
{%- endmacro -%}

{%- macro photo_img() -%}
  {% if photo %}<img class="photo" src="{{ photo }}" alt="Photo of {{ data.name }}" />{% endif %}
{%- endmacro -%}

{#- ------------------------------------------------------------ page -#}
<body class="theme-{{ theme }} layout-{{ layout }}{% if photo %} has-photo{% endif %}">

{% if layout == 'sidebar' %}
<div class="sidebar-layout">
  <aside class="side">
    {{ photo_img() }}
    <h1 class="name">{{ data.name }}</h1>
    {% if data.title %}<div class="role-line">{{ data.title }}</div>{% endif %}
    <section class="section contact-section">
      <h2>Contact</h2>
      {{ contact_list() }}
    </section>
    {{ skills() }}
    {{ education() }}
    {{ simple_list('certifications', 'Certifications') }}
    {{ simple_list('awards', 'Awards') }}
  </aside>
  <main class="main">
    {{ summary() }}
    {{ experience() }}
    {{ project_list('startups', 'Startups') }}
    {{ project_list('projects', 'Projects') }}
    {{ simple_list('publications', 'Publications') }}
  </main>
</div>
{% else %}
<header class="cv-header">
  {{ photo_img() }}
  <div class="head-text">
    <h1 class="name">{{ data.name }}</h1>
    {% if data.title %}<div class="role-line">{{ data.title }}</div>{% endif %}
    {{ contact_line() }}
  </div>
</header>

{{ summary() }}
{{ skills() }}
{{ experience() }}
{{ education() }}
{{ project_list('startups', 'Startups') }}
{{ project_list('projects', 'Projects') }}
{{ simple_list('publications', 'Publications') }}
{{ simple_list('awards', 'Awards') }}
{{ simple_list('certifications', 'Certifications') }}
{% endif %}

</body>
</html>
